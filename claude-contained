#!/usr/bin/env bash
set -euo pipefail

show_help() {
  cat <<'EOF'
Usage:
  claude-contained [options] [main_dir] [extra_dir ...] [-- <tool args...>]

Description:
  Runs AI coding assistants inside an Apple Containers sandbox.

Options:
  -t, --tool TOOL    AI tool to run: claude (default), codex, copilot, gemini, vibe
  -R, --rebuild[=MODE]  Rebuild image and exit: tools (default) or full
  -H PORT[:HOSTPORT] Forward host port to container localhost (can be repeated)
  -p HOST:CONTAINER  Publish container port to host (can be repeated)
  -e, --env KEY=VALUE  Set an env var for the tool process (can be repeated)
  --no-project-env   Ignore the project's .claude-contained/env file
  --dns IP           Use IP as a DNS resolver (can be repeated)
  --allow-host HOST  Allow sandbox egress to HOST (can be repeated)
  --no-sandbox       Disable the srt sandbox (debugging escape hatch)
  -s, --shell        Start a bash shell instead of the AI tool (for debugging)
  -S, --ssh          Enable SSH agent forwarding (for git push)
  -w, --worktree     Auto-include git worktree's main repository (skip prompt)
  -W, --lock-worktrees  Auto-lock hidden linked worktrees (skip prompt)
  -y, --yolo         Skip all permission prompts (tool-specific flag)
  -N, --contained-node-modules  Use container-specific node_modules (skip prompt)
  --share-skills=DIR  Mount shared skill folders from DIR (opt-in)
  --share-host-claude  Mount host ~/.claude directly as container ~/.claude
  --readonly-extras  Mount all extra dirs read-only (suffix overrides per-path)
  -a, --attach [NAME]  Attach to running container (runs tool, or bash with -s)
  --zellij          Run the tool inside a persistent Zellij workspace
  --new-session[=NAME]  With --zellij, start a fresh session target
  -h, --help         Show this help message

Behavior:
  - If no directories are provided, defaults to the current directory.
  - Directories are mounted at their original host paths for full path parity.
  - Additional directories are automatically added via --add-dir (claude, codex only).
  - Append :ro to an extra dir to mount it read-only (or :rw to force read-write).
    The working directory cannot be read-only.
  - Claude uses ~/.claude-contained/claude as container ~/.claude by default.
    Account state remains shared through ~/.claude-contained/.claude.json, and
    host ~/.claude skills, agents, commands, and plugins are mounted into the
    contained profile. Use --share-host-claude or
    CLAUDE_CONTAINED_SHARE_HOST_CLAUDE=1 to mount host ~/.claude directly.
  - Other tool configs (~/.codex, ~/.copilot, ~/.gemini, ~/.vibe), Maven cache
    (~/.m2), and Vaadin state (~/.vaadin) are bind-mounted.
  - --share-skills=DIR mounts DIR as each tool's skills directory.
    For Codex, ~/.codex/skills/.system is mounted back over DIR/.system
    so built-in skills remain visible while new installs write to DIR.
  - SSH agent forwarding is disabled by default; use --ssh to enable (for git push).
  - Apple Containers defaults the container's resolver to the vmnet gateway, which
    often cannot resolve. Use --dns 1.1.1.1, or set CLAUDE_DNS=1.1.1.1 (comma-
    separated for several) to apply it to every run without typing the flag.
  - -e/--env passes env vars to the tool. KEY=VALUE lines in the main directory's
    .claude-contained/env are also applied (--env wins; --no-project-env skips the
    file). That file is writable from inside the container, so keys that would
    subvert the sandbox are refused from it. Neither applies when attaching to an
    existing container, and --env is refused with --zellij --attach, where the
    pane keeps the environment it was created with.
  - Egress is sandboxed with srt: only allowlisted hosts are reachable. Edit
    ~/.claude-contained/srt-settings.json for a persistent policy, --allow-host for
    one run, or --no-sandbox to turn it off while debugging.
  - Git worktrees are detected; main repository's .git directory is mounted for full git access.
  - Linked worktrees hidden from the container can be auto-locked while the container runs.
  - --zellij starts a named Zellij session and keeps the container alive after detach.
    Use --zellij --attach [NAME] to reconnect to a live Zellij session.

Examples:
  claude-contained                     # Run claude in current directory
  claude-contained -t codex .          # Run codex instead
  claude-contained -t copilot .        # Run copilot instead
  claude-contained -t gemini .         # Run gemini instead
  claude-contained -t vibe .           # Run vibe instead
  claude-contained . ../other/project  # Mount extra directories
  claude-contained . ../lib:ro         # Mount ../lib read-only
  claude-contained --readonly-extras . ../a ../b  # All extras read-only
  claude-contained . -- --model sonnet # Pass args to tool
  claude-contained -y -t codex .       # Codex with --yolo
  claude-contained -S .                # Enable SSH agent (for git push)
  claude-contained -s                  # Debug shell in current directory
  claude-contained --rebuild           # Refresh AI tools, then exit
  claude-contained --rebuild=full      # Full fresh rebuild, then exit
  claude-contained -p 8080:8080 .      # Expose port 8080
  claude-contained -H 3845 .           # Forward host:3845 to container localhost:3845
  claude-contained -e API_URL=http://host.local:8080 .  # Set an env var
  claude-contained --dns 1.1.1.1 .     # Fix DNS when the vmnet resolver fails
  claude-contained --allow-host example.com .  # Permit one extra egress host
  claude-contained --no-sandbox -s .   # Debug shell with the sandbox off
  claude-contained --share-skills=/Users/me/Projects/skills .
  claude-contained -a                  # List and attach to running container
  claude-contained -a myproject        # Attach or create named container
  claude-contained --zellij .          # Start this project in Zellij
  claude-contained --zellij --attach   # Attach to a live Zellij-backed container
  claude-contained --zellij --new-session=review .
EOF
}

# Sanitize folder name for container naming
# - Extract basename
# - Lowercase
# - Replace non-alphanumeric with dash
# - Collapse multiple dashes
# - Truncate to max 20 chars
# - Handle empty result
sanitize_foldername() {
  local name
  name="$(basename "$1" | tr '[:upper:]' '[:lower:]')"  # lowercase (portable)
  name="$(echo "$name" | sed 's/[^a-z0-9]/-/g')"        # non-alphanumeric → dash
  name="$(echo "$name" | sed 's/-\{1,\}/-/g')"          # collapse dashes
  name="${name#-}"                                       # trim leading dash
  name="${name%-}"                                       # trim trailing dash
  name="$(echo "$name" | cut -c1-20)"                   # truncate (portable)
  [[ -z "$name" ]] && name="root"                       # fallback
  echo "$name"
}

# Get full executable path for a tool (claude is in /opt/claude, others in standard PATH)
get_tool_path() {
  case "$1" in
    claude) echo "/opt/claude/claude" ;;
    *)      echo "$1" ;;  # codex/gemini/vibe are in /usr/local/bin (standard PATH)
  esac
}

# Build command array for attach mode (tool path + flags)
# Sets global attach_cmd array
build_attach_cmd() {
  # `container exec` bypasses the entrypoint, so re-apply the sandbox explicitly.
  attach_cmd=()
  [[ $srt_disable -eq 0 ]] && attach_cmd+=(srt-run)
  attach_cmd+=("$(get_tool_path "$tool")")
  if [[ $yolo_mode -eq 1 ]]; then
    case "$tool" in
      claude) attach_cmd+=(--dangerously-skip-permissions) ;;
      codex|copilot|gemini) attach_cmd+=(--yolo) ;;
      vibe) echo "Warning: vibe does not support yolo mode" >&2 ;;
    esac
  fi
}

# Build command array for attaching a debug shell (sandbox wrapper + bash)
# Sets global attach_cmd array
build_attach_shell_cmd() {
  attach_cmd=()
  [[ $srt_disable -eq 0 ]] && attach_cmd+=(srt-run)
  attach_cmd+=(bash)
}

build_zellij_attach_cmd() {
  local session="$1"

  attach_cmd=()
  [[ $srt_disable -eq 0 ]] && attach_cmd+=(srt-run)
  attach_cmd+=(/usr/local/bin/zellij-attach "$session")
}

# Environment args for exec (PATH not set by entrypoint when using exec)
exec_env_args() {
  printf '%s ' -e "HOME=$HOME" -e "JAVA_HOME=/opt/jbr" -e "PATH=/opt/claude:/home/dev/.sdkman/candidates/maven/current/bin:/home/dev/.sdkman/candidates/jbang/current/bin:/opt/jbr/bin:$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
}

# Per-project state directory: node_modules overlays and the project env file.
project_state_dir() {
  printf '%s/.claude-contained\n' "$1"
}

# Env keys reserved from every source. These are owned by the launcher or the
# entrypoint, and several are outright levers on the container's own guarantees:
# STAY_ROOT makes the entrypoint skip the `gosu dev` drop, which would leave srt
# running as root; SSH_AUTH_SOCK is copied straight into the sandbox policy's
# allowUnixSockets list. HOME/JAVA_HOME are overwritten by the entrypoint and
# PATH is prepended to, so accepting any of the three would be a lie.
env_key_reserved_always() {
  case "$1" in
    HOST_*|SRT_*|CLAUDE_CONTAINED_*) return 0 ;;
    STAY_ROOT|SSH_AUTH_SOCK|GIT_PROTECT_DIRS|HOME|PATH|JAVA_HOME) return 0 ;;
  esac
  return 1
}

# Env keys reserved only from the project env file. Fine to pass by hand, but
# code injection into the srt process itself when they come from a file the
# contained agent can write.
env_key_reserved_in_file() {
  case "$1" in
    LD_PRELOAD|LD_LIBRARY_PATH|NODE_OPTIONS) return 0 ;;
  esac
  return 1
}

validate_env_assignment() { # validate_env_assignment <KEY=VALUE> <source> <origin>
  local assignment="$1" source="$2" origin="$3" key

  if [[ "$assignment" != *=* ]]; then
    echo "error: ${source}: expected KEY=VALUE, got '${assignment}'" >&2
    return 1
  fi
  key="${assignment%%=*}"
  if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "error: ${source}: not a valid environment variable name: '${key}'" >&2
    return 1
  fi
  if env_key_reserved_always "$key"; then
    echo "error: ${source}: ${key} is reserved by claude-contained and cannot be set" >&2
    return 1
  fi
  if [[ "$origin" == "file" ]] && env_key_reserved_in_file "$key"; then
    echo "error: ${source}: ${key} cannot be set from a project env file" >&2
    echo "       It is read by the sandbox wrapper itself; pass -e ${key}=... if you mean it." >&2
    return 1
  fi
  return 0
}

env_index_of_key() { # env_index_of_key <KEY>; prints index, returns 1 if absent
  local key="$1" i n=${#user_env_keys[@]}

  for (( i = 0; i < n; i++ )); do
    if [[ "${user_env_keys[$i]}" == "$key" ]]; then
      printf '%s\n' "$i"
      return 0
    fi
  done
  return 1
}

# Record KEY=VALUE, replacing any earlier entry for the same key so each key is
# passed to the runtime exactly once: duplicate -e args are not documented to
# resolve last-wins in either runtime, so precedence is settled here instead.
env_set() { # env_set <KEY=VALUE> <source> <origin>
  local assignment="$1" source="$2" origin="$3" key idx

  validate_env_assignment "$assignment" "$source" "$origin" || return 1
  key="${assignment%%=*}"
  if idx="$(env_index_of_key "$key")"; then
    user_env[$idx]="$assignment"
    user_env_origins[$idx]="$origin"
    return 0
  fi
  user_env_keys+=("$key")
  user_env+=("$assignment")
  user_env_origins+=("$origin")
}

# Like env_set, but a key already set by a higher-priority source wins.
# Priority is flags > project env file > launcher built-ins (TZ, GH_TOKEN).
env_default() { # env_default <KEY=VALUE> <source> <origin>
  local key="${1%%=*}"

  env_index_of_key "$key" >/dev/null && return 0
  env_set "$1" "$2" "$3"
}

# Read KEY=VALUE lines from <dir>/.claude-contained/env. Parsed literally and
# never sourced: the contained agent can write this file, so it must not be able
# to get arbitrary code run on the next launch.
load_project_env_file() { # load_project_env_file <dir>
  local dir="$1"
  local file lineno=0 line trimmed key value idx
  file="$(project_state_dir "$dir")/env"

  [[ -f "$file" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"  # tolerate CRLF
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue
    if [[ "$trimmed" != *=* ]]; then
      validate_env_assignment "$trimmed" ".claude-contained/env:${lineno}" file || return 1
    fi
    key="${trimmed%%=*}"
    value="${trimmed#*=}"
    # --env wins over the file; within the file, the last line for a key wins.
    if idx="$(env_index_of_key "$key")" && [[ "${user_env_origins[$idx]}" == "flag" ]]; then
      continue
    fi
    # Strip one matching pair of surrounding quotes; no other expansion happens.
    if [[ ${#value} -ge 2 && "$value" == \"*\" ]]; then
      value="${value:1:${#value}-2}"
    elif [[ ${#value} -ge 2 && "$value" == \'*\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    env_set "${key}=${value}" ".claude-contained/env:${lineno}" file || return 1
  done < "$file"
}

# Report which variables are being passed in, by name only -- values routinely
# hold tokens, and this lands in scrollback. Silent when there are none.
print_user_env_summary() {
  local i n=${#user_env_keys[@]} from_flags="" from_file="" msg="env:"

  for (( i = 0; i < n; i++ )); do
    case "${user_env_origins[$i]}" in
      flag) from_flags="${from_flags:+${from_flags}, }${user_env_keys[$i]}" ;;
      file) from_file="${from_file:+${from_file}, }${user_env_keys[$i]}" ;;
    esac
  done

  [[ -z "$from_flags" && -z "$from_file" ]] && return 0
  [[ -n "$from_flags" ]] && msg="${msg} ${from_flags} (--env)"
  [[ -n "$from_flags" && -n "$from_file" ]] && msg="${msg};"
  [[ -n "$from_file" ]] && msg="${msg} ${from_file} (.claude-contained/env)"
  echo "$msg" >&2
}

# -e args for `container exec`, which cannot reuse exec_env_args: that returns a
# space-joined string the call sites deliberately word-split, so a value with a
# space in it would come apart.
build_user_env_args() {
  local i n=${#user_env[@]}

  user_env_args=()
  for (( i = 0; i < n; i++ )); do
    user_env_args+=( -e "${user_env[$i]}" )
  done
}

resolve_path() {
  if command -v python3 &>/dev/null; then
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"
  elif command -v realpath &>/dev/null; then
    realpath "$1"
  elif command -v readlink &>/dev/null && readlink -f / &>/dev/null; then
    readlink -f "$1"
  else
    # Fallback: works for directories
    (cd "$1" 2>/dev/null && pwd) || echo "$1"
  fi
}

container_arch() {
  local arch
  arch="$(uname -m)"
  # Normalize macOS arm64 to Linux aarch64
  [[ "$arch" == "arm64" ]] && arch="aarch64"
  echo "$arch"
}

path_hash_8() {
  local path="$1"

  if command -v shasum &>/dev/null; then
    printf '%s' "$path" | shasum -a 256 | awk '{print substr($1, 1, 8)}'
  elif command -v sha256sum &>/dev/null; then
    printf '%s' "$path" | sha256sum | awk '{print substr($1, 1, 8)}'
  else
    printf '%s' "$path" | cksum | awk '{printf "%08x\n", $1}'
  fi
}

default_zellij_session_name() {
  local dir="$1"

  printf 'cc-%s-%s\n' "$(sanitize_foldername "$dir")" "$(path_hash_8 "$dir")"
}

validate_zellij_session_name() {
  local name="$1"

  if [[ -z "$name" ]]; then
    echo "error: Zellij session name cannot be empty" >&2
    return 1
  fi
  if [[ "$name" == -* || ! "$name" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "error: invalid Zellij session name: $name" >&2
    echo "       Use only letters, numbers, '_', '.', and '-'; do not start with '-'." >&2
    return 1
  fi
  return 0
}

srt_placeholder_file_is_tracked() {
  local file="$1" dir root rel

  dir="$(dirname "$file")"
  root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || return 1
  rel="${file#${root}/}"
  [[ "$rel" == "$file" ]] && return 1
  git -C "$root" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1
}

cleanup_srt_placeholder_files() {
  local root file name
  local names=(
    .gitconfig
    .gitmodules
    .bashrc
    .bash_profile
    .zshrc
    .zprofile
    .profile
    .ripgreprc
    .mcp.json
  )

  for root in "$@"; do
    [[ -d "$root" ]] || continue
    for name in "${names[@]}"; do
      file="${root}/${name}"
      if [[ -f "$file" && ! -s "$file" && ! -L "$file" ]] && ! srt_placeholder_file_is_tracked "$file"; then
        rm -f -- "$file" 2>/dev/null || true
      fi
    done
  done
}

list_running_aic_containers() {
  container list --quiet 2>/dev/null | grep "^aic-" || true
}

zellij_session_from_env_lines() {
  local line marker=0 session=""

  while IFS= read -r line; do
    case "$line" in
      CLAUDE_CONTAINED_ZELLIJ=1) marker=1 ;;
      CLAUDE_CONTAINED_ZELLIJ_SESSION=*) session="${line#CLAUDE_CONTAINED_ZELLIJ_SESSION=}" ;;
    esac
  done

  [[ $marker -eq 1 && -n "$session" ]] && printf '%s\n' "$session"
}

container_zellij_session() {
  local name="$1"

  zellij_session_from_env_lines < <(
    container inspect "$name" 2>/dev/null | jq -r '
      def inspect_objects:
        if type == "array" then .[] else . end;
      def envlines:
        if type == "array" then
          .[] | if type == "string" then .
                elif type == "object" and has("name") and has("value") then "\(.name)=\(.value)"
                elif type == "object" then to_entries[] | "\(.key)=\(.value)"
                else empty end
        elif type == "object" then
          to_entries[] | "\(.key)=\(.value)"
        else empty end;
      inspect_objects | [
        .configuration.initProcess.environment?,
        .Configuration.InitProcess.Environment?,
        .config.env?,
        .Config.Env?
      ] | .[]? | envlines
    ' 2>/dev/null || true
  )
}

load_live_zellij_records() {
  local name session

  zellij_container_names=()
  zellij_session_names=()
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    session="$(container_zellij_session "$name")"
    if [[ -n "$session" ]]; then
      zellij_container_names+=("$name")
      zellij_session_names+=("$session")
    fi
  done < <(list_running_aic_containers)
}

dir_is_empty() {
  local entry
  for entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [[ -e "$entry" ]] && return 1
  done
  return 0
}

# Detect host's IANA timezone (e.g. "Europe/Helsinki") so the container clock
# matches the host. Works on macOS (/var/db/timezone/zoneinfo/...) and Linux
# (/usr/share/zoneinfo/...). Falls back to $TZ if set, then empty.
host_timezone() {
  if [[ -n "${TZ:-}" ]]; then
    echo "$TZ"
    return
  fi
  local link
  link="$(readlink /etc/localtime 2>/dev/null)" || return 0
  [[ "$link" == */zoneinfo/* ]] && echo "${link#*/zoneinfo/}"
}

find_build_context() {
  local script_path script_dir repo_root
  script_path="$(resolve_path "$0")"
  script_dir="$(dirname "$script_path")"
  if [[ -f "${script_dir}/Dockerfile" ]]; then
    echo "$script_dir"
    return 0
  fi
  repo_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)" || true
  if [[ -n "$repo_root" && -f "${repo_root}/Dockerfile" ]]; then
    echo "$repo_root"
    return 0
  fi
  return 1
}

run_rebuild() {
  local mode="$1"
  local build_context refresh_token

  build_context="$(find_build_context)" || {
    echo "Rebuild requires a repo-adjacent install with Dockerfile access." >&2
    echo "Place claude-contained in this repo checkout (or symlink to it) and retry." >&2
    exit 1
  }

  case "$mode" in
    tools)
      refresh_token="$(date -u +%Y%m%d%H%M%S)"
      echo "Rebuilding claude-contained image (AI tools refresh)..." >&2
      if container build --build-arg "AI_TOOLS_CACHE_BUST=${refresh_token}" -t claude-contained:latest "$build_context"; then
        return 0
      fi
      echo "AI tools refresh failed. Retrying with full rebuild..." >&2
      run_rebuild full
      return
      ;;
    full)
      echo "Rebuilding claude-contained image (full fresh rebuild)..." >&2
      container build --pull --no-cache -t claude-contained:latest "$build_context"
      ;;
    *)
      echo "Unknown rebuild mode: $mode" >&2
      echo "Supported rebuild modes: tools, full" >&2
      exit 1
      ;;
  esac
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  show_help
  exit 0
fi

# Parse flags (can appear in any order)
shell_mode=0
ssh_mode=0
worktree_mode=0
lock_worktrees=0
yolo_mode=0
contained_node_modules=0
attach_mode=0
attach_name=""
custom_container_name=""
zellij_mode=0
zellij_new_session=0
zellij_new_session_name=""
zellij_new_session_name_set=0
rebuild_mode="none"
tool="claude"
ro_default=0
share_skills_dir=""
port_maps=()
host_forwards=()
dns_servers=()
srt_allow_hosts=()
srt_disable=0
env_flag_args=()
no_project_env=0
user_env=()
user_env_keys=()
user_env_origins=()
user_env_args=()
share_host_claude=0
[[ "${CLAUDE_CONTAINED_SHARE_HOST_CLAUDE:-}" == "1" ]] && share_host_claude=1
while [[ "${1:-}" == -* ]]; do
  case "${1:-}" in
    -h|--help)
      show_help
      exit 0
      ;;
    --readonly-extras)
      ro_default=1
      shift
      ;;
    --share-skills)
      echo "error: --share-skills requires --share-skills=DIR" >&2
      exit 2
      ;;
    --share-skills=*)
      share_skills_dir="${1#*=}"
      if [[ -z "$share_skills_dir" ]]; then
        echo "error: --share-skills requires a non-empty directory" >&2
        exit 2
      fi
      shift
      ;;
    --share-host-claude)
      share_host_claude=1
      shift
      ;;
    --rebuild)
      rebuild_mode="tools"
      shift
      ;;
    --rebuild=*)
      rebuild_mode="${1#*=}"
      shift
      ;;
    -R)
      if [[ "${2:-}" == "tools" || "${2:-}" == "full" ]]; then
        rebuild_mode="$2"
        shift 2
      else
        rebuild_mode="tools"
        shift
      fi
      ;;
    -s|--shell)
      shell_mode=1
      shift
      ;;
    -S|--ssh)
      ssh_mode=1
      shift
      ;;
    -w|--worktree)
      worktree_mode=1
      shift
      ;;
    -W|--lock-worktrees)
      lock_worktrees=1
      shift
      ;;
    -y|--yolo)
      yolo_mode=1
      shift
      ;;
    -N|--contained-node-modules)
      contained_node_modules=1
      shift
      ;;
    -t|--tool)
      shift
      tool="$1"
      shift
      ;;
    -e|--env)
      shift
      # A leading dash can never be a valid assignment, so treat it as a missing
      # value rather than swallowing the next flag.
      if [[ -z "${1:-}" || "${1}" == -* ]]; then
        echo "error: -e/--env requires KEY=VALUE" >&2
        exit 2
      fi
      env_flag_args+=("$1")
      shift
      ;;
    --env=*)
      env_flag_args+=("${1#*=}")
      shift
      ;;
    --no-project-env)
