CASE_DESCRIPTION="first run migrates a regular ~/.claude.json into the shared dir behind a symlink, and copies ~/.gitconfig"

# The first-run half of the mutation that can destroy credentials. Both host
# changes here are the same bash block (claude-contained:1824-1836): the git
# config copy and the account-state move+link, in that order. The manifest
# records the moved file's bytes at the shared path and the symlink's target,
# so a port that dropped either the move or the link diverges loudly rather
# than exiting 0 with the same runtime arguments.
case_setup() {
  local home="$2"

  printf '{"seeded":"account-state"}\n' > "${home}/.claude.json"
  printf '[user]\n\tname = Differential Harness\n' > "${home}/.gitconfig"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1")
}
