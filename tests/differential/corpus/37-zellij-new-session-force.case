CASE_DESCRIPTION="--zellij --new-session starts another session even while a different one is already live"

case_setup() {
  local proj="$1" home="$2" listfile inspectdir

  listfile="${home}/.diff-stub-list"
  inspectdir="${home}/.diff-stub-inspect"
  mkdir -p "$inspectdir"

  printf 'aic-other\n' > "$listfile"
  printf 'CLAUDE_CONTAINED_ZELLIJ=1\nCLAUDE_CONTAINED_ZELLIJ_SESSION=existing-session\n' > "${inspectdir}/aic-other.env"

  export DIFF_LIST_OUTPUT="$listfile"
  export DIFF_INSPECT_DIR="$inspectdir"
}

case_args() {
  CASE_ARGS_OUT=(-N -s --zellij --new-session --session my-new-session -C "$1")
}
