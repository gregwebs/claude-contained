CASE_DESCRIPTION="--share-skills mounts a symlinked directory target and its own nested symlink"

case_setup() {
  mkdir -p "$1/skills-src" "$1/target-dir"
  echo "content" > "$1/target-dir/file.md"
  mkdir -p "$1/nested-target"
  echo "nested" > "$1/nested-target/file.md"
  ln -s "$1/target-dir" "$1/skills-src/dir-link"
  ln -s "$1/nested-target" "$1/target-dir/nested-link"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1" --share-skills "$1/skills-src")
}
