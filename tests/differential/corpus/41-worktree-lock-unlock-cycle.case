CASE_DESCRIPTION="a hidden linked worktree is auto-locked for the run and unlocked again on exit (-W skips the prompt)"

# The runtime argv for this invocation never mentions the lock at all -- the
# lock/unlock is a pure filesystem side effect, so the only way to prove it
# happened is a manifest snapshot taken *while the container is up*. Locking
# happens before the stub "container run" call and unlocking happens in the
# launcher's own EXIT trap right after it returns, so DIFF_SNAPSHOT_PATHS
# (see isolate.sh) captures the hidden worktree's lock file at exactly the
# right moment: the stub copies it into the fixture tree before returning,
# so the ordinary manifest walk picks up the transient locked state even
# though the final on-disk state (after cleanup) is unlocked again.
case_setup() {
  local proj="$1" main_repo active_wt hidden_wt hidden_gitdir

  main_repo="${proj}/main-repo"
  active_wt="${proj}/wt-active"
  hidden_wt="${proj}/wt-hidden"

  git init --quiet -b main "$main_repo" 2>/dev/null
  git -C "$main_repo" config user.email test@example.com
  git -C "$main_repo" config user.name "Differential Harness"
  echo "root" > "${main_repo}/README.md"
  git -C "$main_repo" add README.md
  git -C "$main_repo" commit --quiet -m "initial"

  git -C "$main_repo" worktree add --quiet -b active-branch "$active_wt"
  git -C "$main_repo" worktree add --quiet -b hidden-branch "$hidden_wt"

  hidden_gitdir="$(git -C "$hidden_wt" rev-parse --absolute-git-dir)"
  export DIFF_SNAPSHOT_PATHS="${hidden_gitdir}/locked"

  # Stash the active worktree path for case_args, which only receives the
  # fixture's project/home roots, not this function's locals.
  printf '%s' "$active_wt" > "${proj}/.diff-active-worktree-path"
}

case_args() {
  local active_wt
  active_wt="$(cat "$1/.diff-active-worktree-path")"
  # -w auto-includes the main repo's .git (skips the "mount main repo?"
  # prompt); -W auto-locks the hidden worktree (skips the separate lock
  # offer prompt). Both are needed or a bare, unfed `read -p` under `set -e`
  # kills the script before it ever reaches the worktree-lock logic at all.
  CASE_ARGS_OUT=(-N -s -w -W -C "$active_wt")
}
