CASE_DESCRIPTION="a worktree the user locked by hand is left completely untouched by the auto-lock offer, which only picks up the other, truly-hidden worktree in the same repository"

case_setup() {
  local proj="$1" main_repo active_wt user_wt hidden_wt hidden_gitdir

  main_repo="${proj}/main-repo"
  active_wt="${proj}/wt-active"
  user_wt="${proj}/wt-user-locked"
  hidden_wt="${proj}/wt-hidden"

  git init --quiet -b main "$main_repo" 2>/dev/null
  git -C "$main_repo" config user.email test@example.com
  git -C "$main_repo" config user.name "Differential Harness"
  echo "root" > "${main_repo}/README.md"
  git -C "$main_repo" add README.md
  git -C "$main_repo" commit --quiet -m "initial"

  git -C "$main_repo" worktree add --quiet -b active-branch "$active_wt"
  git -C "$main_repo" worktree add --quiet -b user-branch "$user_wt"
  git -C "$main_repo" worktree add --quiet -b hidden-branch "$hidden_wt"
  git -C "$main_repo" worktree lock --reason mine "$user_wt"

  # Snapshot the truly-hidden worktree's lock file mid-run, to prove it really
  # was auto-locked (and not just left alone the same way the user's is) --
  # the final manifest alone cannot distinguish "correctly locked then
  # released" from "never locked at all".
  hidden_gitdir="$(git -C "$hidden_wt" rev-parse --absolute-git-dir)"
  export DIFF_SNAPSHOT_PATHS="${hidden_gitdir}/locked"

  printf '%s' "$active_wt" > "${proj}/.diff-active-worktree-path"
}

case_args() {
  local active_wt
  active_wt="$(cat "$1/.diff-active-worktree-path")"
  # -W skips the interactive offer entirely, so this entry isolates the
  # owner-list bookkeeping from the prompt path already covered by 52/53.
  CASE_ARGS_OUT=(-N -s -w -W -C "$active_wt")
}
