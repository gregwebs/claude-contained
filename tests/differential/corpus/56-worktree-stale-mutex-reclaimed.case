CASE_DESCRIPTION="a worktree auto-lock mutex left behind by a dead launcher is reclaimed rather than timed out on: the reclaim note appears on stderr, the hidden worktree is still locked, and the mutex directory is gone afterward"

case_setup() {
  local proj="$1" main_repo active_wt hidden_wt hidden_gitdir dead mutex_dir

  main_repo="${proj}/main-repo"
  active_wt="${proj}/wt-active"
  hidden_wt="${proj}/wt-hidden"

  git init --quiet -b main "$main_repo" 2>/dev/null
  git -C "$main_repo" config user.email test@example.com
  git -C "$main_repo" config user.name "Differential Harness"
  echo "root" > "${main_repo}/README.md"
  git -C "$main_repo" add README.md
  git -C "$main_repo" commit --quiet -m "initial"

  git -C "$main_repo" worktree add --quiet -b active-branch "$active_wt"
  git -C "$main_repo" worktree add --quiet -b hidden-branch "$hidden_wt"

  # A reliably-dead PID: spawn a subshell and reap it immediately.
  ( exit 0 ) & dead=$!
  wait "$dead" 2>/dev/null

  mutex_dir="${main_repo}/.git/claude-contained-worktree-locks.lock"
  mkdir -p "$mutex_dir"
  printf '%s %s\n' "$dead" "$(date +%s)" > "${mutex_dir}/owner"

  hidden_gitdir="$(git -C "$hidden_wt" rev-parse --absolute-git-dir)"
  export DIFF_SNAPSHOT_PATHS="${hidden_gitdir}/locked"

  printf '%s' "$active_wt" > "${proj}/.diff-active-worktree-path"
}

case_args() {
  local active_wt
  active_wt="$(cat "$1/.diff-active-worktree-path")"
  CASE_ARGS_OUT=(-N -s -w -W -C "$active_wt")
}
