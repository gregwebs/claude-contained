CASE_DESCRIPTION="--zellij --attach reconnects directly when exactly one Zellij session is live"

case_setup() {
  local proj="$1" home="$2" listfile inspectdir

  listfile="${home}/.diff-stub-list"
  inspectdir="${home}/.diff-stub-inspect"
  mkdir -p "$inspectdir"

  printf 'aic-live1\n' > "$listfile"
  printf 'CLAUDE_CONTAINED_ZELLIJ=1\nCLAUDE_CONTAINED_ZELLIJ_SESSION=my-session\n' > "${inspectdir}/aic-live1.env"

  export DIFF_LIST_OUTPUT="$listfile"
  export DIFF_INSPECT_DIR="$inspectdir"
}

case_args() {
  # --zellij --attach cannot be combined with --shell; the attach path always
  # execs the previously-created pane's own command.
  CASE_ARGS_OUT=(-N --zellij --attach -C "$1")
}
