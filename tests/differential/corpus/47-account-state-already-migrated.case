CASE_DESCRIPTION="a second run leaves an already-migrated ~/.claude.json symlink and its shared target completely alone"

# Models "run the launcher twice": the harness invokes each target exactly once
# per side, so the post-first-run state is seeded instead of produced.
#
# This is the entry that catches the credential-destroying port. bash tests
# `-f && ! -L`, where `-f` follows the link and `-L` does not; a port using one
# symlink-following stat for both halves reports "regular file" here, takes the
# migrate branch, and renames the symlink over its own target -- leaving
# ~/.claude-contained/.claude.json pointing at itself with the real bytes gone,
# which the next run then cleans up as dangling. The manifest records symlink
# targets and file contents, so that appears as a divergence instead of as an
# identical exit status.
case_setup() {
  local home="$2"

  mkdir -p "${home}/.claude-contained"
  printf '{"seeded":"account-state"}\n' > "${home}/.claude-contained/.claude.json"
  ln -s "${home}/.claude-contained/.claude.json" "${home}/.claude.json"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1")
}
