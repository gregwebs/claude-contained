CASE_DESCRIPTION="zero-byte srt placeholder files are swept from the project directory and every extra mount, while tracked and non-empty ones survive"

# The unit test in internal/host covers the four guards on the function itself;
# what this entry covers is the *wiring* -- which roots the launcher actually
# hands it. bash sweeps the project directory alone first
# (claude-contained:1410) and then every mounted root (:1461), so a port that
# passed only the project directory would leave the extra mounts' placeholders
# on disk and diverge in the manifest, with byte-identical runtime arguments.
#
# The read-only extra is included deliberately: the sweep does not skip
# read-only mounts -- only the node_modules overlay does -- so its placeholder
# must go too.
#
# Only the before-startup sweep is observable here. The after-exit sweep would
# need the stub to *create* a placeholder mid-run, which DIFF_SNAPSHOT_PATHS
# cannot do; that stays covered by the unit test plus code review.
case_setup() {
  local proj="$1"

  : > "${proj}/.bashrc"
  printf 'keep me\n' > "${proj}/.zshrc"

  mkdir -p "${proj}/extra-rw" "${proj}/extra-ro"
  : > "${proj}/extra-rw/.gitconfig"
  : > "${proj}/extra-ro/.profile"

  # A tracked zero-byte placeholder in a real repository: it satisfies every
  # other guard and must still survive.
  git init --quiet -b main "${proj}/tracked-repo" 2>/dev/null
  : > "${proj}/tracked-repo/.mcp.json"
  git -C "${proj}/tracked-repo" add -f .mcp.json
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1" -m "$1/extra-rw" -m "$1/extra-ro:ro" -m "$1/tracked-repo")
}
