CASE_DESCRIPTION="a ~/.claude.json symlink with nothing behind it is removed and not replaced"

# The repair branch (claude-contained:1833-1836), plus the separate
# link-if-missing block below it (:1839-1841) declining to fire. bash removes
# the link only when `-e` on the shared path is false, and re-links only when
# `-f` on the shared path is true -- neither holds here, so the correct
# post-run state has no ~/.claude.json at all.
#
# The launcher's `mkdir -p ~/.claude-contained` creates only the directory,
# never the file, so bash testing the shared path after that mkdir and the Go
# probe testing it before agree.
case_setup() {
  local home="$2"

  ln -s "${home}/.claude-contained/.claude.json" "${home}/.claude.json"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1")
}
