CASE_DESCRIPTION="--zellij --attach with multiple live sessions prompts a picker (scripted stdin choice)"

case_setup() {
  local proj="$1" home="$2" listfile inspectdir

  listfile="${home}/.diff-stub-list"
  inspectdir="${home}/.diff-stub-inspect"
  mkdir -p "$inspectdir"

  printf 'aic-live1\naic-live2\n' > "$listfile"
  printf 'CLAUDE_CONTAINED_ZELLIJ=1\nCLAUDE_CONTAINED_ZELLIJ_SESSION=alpha\n' > "${inspectdir}/aic-live1.env"
  printf 'CLAUDE_CONTAINED_ZELLIJ=1\nCLAUDE_CONTAINED_ZELLIJ_SESSION=beta\n' > "${inspectdir}/aic-live2.env"

  export DIFF_LIST_OUTPUT="$listfile"
  export DIFF_INSPECT_DIR="$inspectdir"
}

case_args() {
  # --zellij --attach cannot be combined with --shell; the attach path always
  # execs the previously-created pane's own command.
  CASE_ARGS_OUT=(-N --zellij --attach -C "$1")
}

case_stdin() {
  CASE_STDIN_OUT="2
"
}
