CASE_DESCRIPTION="a file-only-reserved key (LD_PRELOAD) from the project env file is rejected before any runtime argument is built; the same key via -e is fine"
CASE_EXPECT_RUNTIME_ARGS=0

case_setup() {
  mkdir -p "$1/.claude-contained"
  printf 'LD_PRELOAD=/tmp/evil.so\n' > "$1/.claude-contained/env"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1")
}
