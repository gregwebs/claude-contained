CASE_DESCRIPTION="a dangling symlink inside the shared skills directory is rejected"
CASE_EXPECT_RUNTIME_ARGS=0

case_setup() {
  mkdir -p "$1/skills-src"
  ln -s "$1/skills-src/does-not-exist" "$1/skills-src/broken-link"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1" --share-skills "$1/skills-src")
}
