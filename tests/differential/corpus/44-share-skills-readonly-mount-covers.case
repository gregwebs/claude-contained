CASE_DESCRIPTION="a read-only extra mount covering an ancestor directory satisfies the shared skills self-mount"

case_setup() {
  mkdir -p "$1/skills-parent/skills-src"
  echo "skill" > "$1/skills-parent/skills-src/example.md"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1" -m "$1/skills-parent:ro" --share-skills "$1/skills-parent/skills-src")
}
