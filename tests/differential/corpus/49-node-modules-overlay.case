CASE_DESCRIPTION="-N overlays container-specific node_modules for the project and read-write extra mounts, skips read-only ones, and announces only the overlays it had to create"

# Three branches of the overlay loop (claude-contained:1893-1930) in one
# fixture, because they differ only in what the loop does per candidate
# directory: the project dir has no overlay yet (created -> the two-line
# "Created ..." notice on stderr), the read-write extra mount already has a
# populated overlay (mount emitted, no notice -- the branch that pins the
# emptiness test, which a port that always announces would get wrong), and the
# read-only extra mount is skipped entirely because the overlay has to write
# .claude-contained/ inside the directory.
#
# macOS-only by construction (`uname != Linux`), which is fine: this repo runs
# on macOS hosts. On a Linux host both sides would agree by both doing nothing,
# and the run still emits runtime arguments, so the no-observable-result guard
# would not fire.
case_setup() {
  local proj="$1" arch platform

  # The overlay directory name embeds the container architecture, so compute it
  # the way container_arch() does (claude-contained:349-355) instead of
  # hardcoding aarch64, which would fail on an Intel host.
  arch="$(uname -m)"
  [[ "$arch" == "arm64" ]] && arch="aarch64"
  platform="linux-${arch}"

  printf '{"name":"proj"}\n' > "${proj}/package.json"

  mkdir -p "${proj}/extra-rw/.claude-contained/node_modules-${platform}/prebuilt"
  printf '{"name":"extra-rw"}\n' > "${proj}/extra-rw/package.json"
  printf 'x\n' > "${proj}/extra-rw/.claude-contained/node_modules-${platform}/prebuilt/index.js"

  mkdir -p "${proj}/extra-ro"
  printf '{"name":"extra-ro"}\n' > "${proj}/extra-ro/package.json"
}

case_args() {
  CASE_ARGS_OUT=(-N -s -C "$1" -m "$1/extra-rw" -m "$1/extra-ro:ro")
}
